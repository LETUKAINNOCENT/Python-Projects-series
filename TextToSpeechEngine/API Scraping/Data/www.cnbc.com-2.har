            "text": "{\"data\":{\"showsSchedule\":{\"scheduleStartTime\":\"2026-05-29 09:16 am\",\"scheduleEndTime\":\"2026-05-30 12:16 am\",\"currDate\":\"2026-05-29\",\"live\":{\"guid\":\"00003EP007980492905T0529261300\",\"url\":\"squawk-box-us/\",\"startTimeFormatted\":\"09:00 am\",\"endTimeFormatted\":\"12:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780059600,\"endTime\":1780070400,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP007980492905\",\"title\":\"Squawk on the Street\",\"episodeGuid\":\"EP007980492905\",\"description\":\"Taking viewers onto the floor of the exchange, right to the posts where the big companies in the world trade; tick charts track the action of every trade of every stock; the treasury, currency and commodity action in real time.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":10800,\"secondaryTitle\":null,\"seriesEpisodeNumber\":2897,\"shortTitle\":\"Squawk on the Street\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":108,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP007980492905\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},\"comingUp\":[{\"guid\":\"00003EP043359570518T0529261600\",\"url\":\"live-tv\",\"startTimeFormatted\":\"12:00 pm\",\"endTimeFormatted\":\"01:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780070400,\"endTime\":1780074000,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP043359570518\",\"title\":\"Halftime Report\",\"episodeGuid\":\"EP043359570518\",\"description\":\"The front lines of market coverage; host Scott Wapner and the top investors get to the heart of the action as it's happening and help set the agenda for the rest of the day.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":1661,\"shortTitle\":\"Halftime Report\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP043359570518\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP031237411731T0529261700\",\"url\":\"live-tv\",\"startTimeFormatted\":\"01:00 pm\",\"endTimeFormatted\":\"02:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780074000,\"endTime\":1780077600,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP031237411731\",\"title\":\"The Exchange\",\"episodeGuid\":\"EP031237411731\",\"description\":\"Anchor Kelly Evans reports on the important stories to markets and investors; reporters provide actionable information to viewers as they make daily investment decisions.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":1726,\"shortTitle\":\"The Exchange\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP031237411731\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP001728382326T0529261800\",\"url\":\"power-lunch/\",\"startTimeFormatted\":\"02:00 pm\",\"endTimeFormatted\":\"03:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780077600,\"endTime\":1780081200,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP001728382326\",\"title\":\"Power Lunch\",\"episodeGuid\":\"EP001728382326\",\"description\":\"Focusing on real-time market coverage, breaking news and up-to-the-instant stock moving information; delving into the economy, the markets, real estate, media and technology -- any place where there's money to be made.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":2317,\"shortTitle\":\"Power Lunch\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP001728382326\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP003045341764T0529261900\",\"url\":\"closing-bell/\",\"startTimeFormatted\":\"03:00 pm\",\"endTimeFormatted\":\"04:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780081200,\"endTime\":1780084800,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP003045341764\",\"title\":\"Closing Bell\",\"episodeGuid\":\"EP003045341764\",\"description\":\"A guide through the most important hour of the Wall Street trading day, and taking a close-up look at how the markets are moving, what's driving them and how investors are reacting; coverage includes reports from the CME Group, NASDAQ and the NYSE.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":1759,\"shortTitle\":\"Closing Bell\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP003045341764\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP042274471098T0529262000\",\"url\":\"closing-bell/\",\"startTimeFormatted\":\"04:00 pm\",\"endTimeFormatted\":\"05:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780084800,\"endTime\":1780088400,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP042274471098\",\"title\":\"Closing Bell: Overtime\",\"episodeGuid\":\"EP042274471098\",\"description\":\"Melissa Lee and Michael Santoli take viewers through all the after-hours moves including breaking news, corporate earnings and post-market trading; strategists and money managers debate actionable ideas and the market themes of the day.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":1098,\"shortTitle\":\"Closing Bell: Overtime\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP042274471098\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP008437284150T0529262100\",\"url\":\"live-tv/fast-money\",\"startTimeFormatted\":\"05:00 pm\",\"endTimeFormatted\":\"06:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780088400,\"endTime\":1780092000,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP008437284150\",\"title\":\"Fast Money\",\"episodeGuid\":\"EP008437284150\",\"description\":\"The information normally reserved for the Wall Street trading floor, enabling viewers to make decisions that give them a chance to make money; the news with an angle that won't be seen until tomorrow's papers.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":n