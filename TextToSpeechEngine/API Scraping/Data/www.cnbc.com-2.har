layer\",\"description\":\"\"},{\"id\":\"icNewsletters\",\"name\":\"Investing Club Newsletters\",\"description\":\"\"}],\"bundle_roles\":[\"InvestingClub\"]},{\"bundle_id\":\"ProICBundle\",\"features\":[{\"id\":\"proArticles\",\"name\":\"Pro Articles\",\"description\":\"Aritcles with premium content classification\"},{\"id\":\"livestreamEU\",\"name\":\"Live TV Europe Stream\",\"description\":\"Europe Live TV Stream\"},{\"id\":\"noDisplayAds\",\"name\":\"No Display Ads\",\"description\":\"No display ads on the site\"},{\"id\":\"analystConsensus\",\"name\":\"Analyst Consensus\",\"description\":\"Analyst Consensus widget in quote page and article embeds\"},{\"id\":\"proVideos\",\"name\":\"Pro Videos\",\"description\":\"Videos with premium content classification\"},{\"id\":\"livestreamAS\",\"name\":\"Live TV Asia Stream\",\"description\":\"Asia Live TV Stream\"},{\"id\":\"charitableTrust\",\"name\":\"Charitable Trust Portfolio\",\"description\":\"\"},{\"id\":\"icArticles\",\"name\":\"Investing Club Articles\",\"description\":\"\"},{\"id\":\"icLiveEvents\",\"name\":\"Investing Club Live Events\",\"description\":\"\"},{\"id\":\"icVideos\",\"name\":\"Investing Club Video Player\",\"description\":\"\"},{\"id\":\"livestreamUS\",\"name\":\"Live TV US Stream\",\"description\":\"US Live TV Stream\"},{\"id\":\"proLiveEvents\",\"name\":\"Pro Live Event\",\"description\":\"Pro Live Event player\"},{\"id\":\"proNewsletters\",\"name\":\"Pro Newsletters\",\"description\":\"Access to Pro Newsletters signup\"},{\"id\":\"livestreamData\",\"name\":\"Live TV Europe Stream\",\"description\":\"Europe Live TV Stream\"},{\"id\":\"stockScreener\",\"name\":\"Stock Screener\",\"description\":\"Stock Screener tool\"},{\"id\":\"quoteDetailsSideDrawer\",\"name\":\"Quote details side drawer\",\"description\":\"\"},{\"id\":\"customMarketsBanner\",\"name\":\"Custom Markets Banner\",\"description\":\"Ability to customize the markets banner\"},{\"id\":\"businessDayFullEpisodes\",\"name\":\"Business Day Full Episodes\",\"description\":\"Business day show full episodes\"},{\"id\":\"icNewsletters\",\"name\":\"Investing Club Newsletters\",\"description\":\"\"},{\"id\":\"myPortfolio\",\"name\":\"My Portfolio\",\"description\":\"My Portfolio tool\"},{\"id\":\"enhancedMarketTableEmbed\",\"name\":\"Enhanced Market Table Embed\",\"description\":\"News and Peers side drawer CTAs under embedded market table\"}],\"bundle_roles\":[\"InvestingClub\",\"PRO\"]},{\"bundle_id\":\"Plus\",\"features\":[{\"id\":\"livestreamGlobal\",\"name\":\"Live TV Global Stream\",\"description\":\"\"},{\"id\":\"livestreamData\",\"name\":\"Live TV Data Stream\",\"description\":\"Data Stream\"},{\"id\":\"businessDayFullEpisodes\",\"name\":\"Business Day Full Episodes\",\"description\":\"Business day show full episodes\"}],\"bundle_roles\":[\"Plus\"]},{\"bundle_id\":\"aiChatbot\",\"features\":[{\"id\":\"chatbot\",\"name\":\"AI Chatbot\",\"description\":\"Access to the AI chatbot\"}],\"bundle_roles\":[\"aiChatbot\"]},{\"bundle_id\":\"AiChatbotAdmin\",\"features\":[],\"bundle_roles\":[\"AiChatbotAdmin\"]}]; \n    (function() {\n      var intervalId;\n      var maxAttempts = 50;\n      var attempts = 0;\n      \n      // Set up integration object immediately so it's available when Web Experiment script loads\n      window.experimentIntegration = {\n        getUser: function() {\n          try {\n            if (!window.mParticle?.Identity) return {};\n            var currentUser = window.mParticle.Identity.getCurrentUser();\n            var userId = currentUser?.getUserIdentities()?.userIdentities?.customerid;\n            var deviceId = window.mParticle.getDeviceId?.();\n            var user = {};\n            if (userId != null) user.user_id = userId;\n            if (deviceId != null) user.device_id = deviceId;\n            return user;\n          } catch (error) {\n            return {};\n          }\n        },\n        track: function(e) {\n          try {\n            if (window.mParticle?.logEvent) {\n              window.mParticle.logEvent(e.eventType, window.mParticle.EventType?.Other, e.eventProperties);\n              return true;\n            }\n            return false;\n          } catch (error) {\n            return false;\n          }\n        }\n      };\n      \n      var init = function() {\n        intervalId = setInterval(function() {\n          attempts++;\n          \n          if (attempts >= maxAttempts) {\n            clearInterval(intervalId);\n            return;\n          }\n          \n          // Wait for mParticle to be fully initialized with Identity\n          if (!window.mParticle || !window.mParticle.Identity) {\n            return;\n          }\n          \n          // Poll for Analytics SDK - check multiple possible globals\n          var isAnalyticsSdkReady = (\n            (window.amplitude && typeof window.amplitude.getInstance === 'function') ||\n            (window.analytics && typeof window.analytics.track === 'function') ||\n            (window._satellite && window._satellite._monitors)\n          );\n          \n          if (!isAnalyticsSdkReady) {\n            return;\n          }\n          \n          // Wait for Web Experiment SDK to be loaded\n          if (!window.experiment || typeof window.experiment.init !== 'function') {\n            return;\n          }\n\n          clearInterval(intervalId);\n          \n          // Initialize Web Experiment SDK now that all dependencies are ready\n          try {\n            window.experiment.init();\n          } catch (error) {\n            return;\n          }\n        }, 300);\n      };\n      \n      init();\n    })();\n  </script><script charSet=\"UTF-8\">\n            \n    (function() {\n      var attempts = 0;\n      var maxAttempts = 30;\n      var experimentUrl = 'https://cdn.amplitude.com/script/62f692ae4fb5e969ec8d0521818bf2c0.experiment.js';\n      function loadExperimentSdk(reason) {\n        if (reason) console.log('[Experiment] ' + reason);\n        va