            "text": "{\"data\":{\"showsSchedule\":{\"scheduleStartTime\":\"2026-05-29 05:41 am\",\"scheduleEndTime\":\"2026-05-30 12:41 am\",\"currDate\":\"2026-05-29\",\"live\":{\"guid\":\"00003EP063462810051T0529260900\",\"url\":\"live-tv\",\"startTimeFormatted\":\"05:00 am\",\"endTimeFormatted\":\"06:00 am\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780045200,\"endTime\":1780048800,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP063462810051\",\"title\":\"Morning Call\",\"episodeGuid\":\"EP063462810051\",\"description\":\"Morgan Brennan delivers the essential market intelligence that drives the trading day ahead; capture breaking business news as it unfolds and tracks pre-market equity moves, commodity swings, U.S. futures, and overnight action across global markets.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":54,\"shortTitle\":\"Morning Call\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":54,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP063462810051\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},\"comingUp\":[{\"guid\":\"00003EP001598931889T0529261000\",\"url\":\"squawk-box-us/\",\"startTimeFormatted\":\"06:00 am\",\"endTimeFormatted\":\"09:00 am\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780048800,\"endTime\":1780059600,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP001598931889\",\"title\":\"Squawk Box\",\"episodeGuid\":\"EP001598931889\",\"description\":\"The big names in business and politics tell their important stories in this pre-market morning news and talk program; from professional traders to casual investors.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":10800,\"secondaryTitle\":null,\"seriesEpisodeNumber\":1866,\"shortTitle\":\"Squawk Box\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP001598931889\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP007980492905T0529261300\",\"url\":\"squawk-box-us/\",\"startTimeFormatted\":\"09:00 am\",\"endTimeFormatted\":\"12:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780059600,\"endTime\":1780070400,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP007980492905\",\"title\":\"Squawk on the Street\",\"episodeGuid\":\"EP007980492905\",\"description\":\"Taking viewers onto the floor of the exchange, right to the posts where the big companies in the world trade; tick charts track the action of every trade of every stock; the treasury, currency and commodity action in real time.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":10800,\"secondaryTitle\":null,\"seriesEpisodeNumber\":2897,\"shortTitle\":\"Squawk on the Street\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":108,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP007980492905\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP043359570518T0529261600\",\"url\":\"squawk-box-us/\",\"startTimeFormatted\":\"12:00 pm\",\"endTimeFormatted\":\"01:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780070400,\"endTime\":1780074000,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP043359570518\",\"title\":\"Halftime Report\",\"episodeGuid\":\"EP043359570518\",\"description\":\"The front lines of market coverage; host Scott Wapner and the top investors get to the heart of the action as it's happening and help set the agenda for the rest of the day.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":1661,\"shortTitle\":\"Halftime Report\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP043359570518\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP031237411731T0529261700\",\"url\":\"squawk-box-us/\",\"startTimeFormatted\":\"01:00 pm\",\"endTimeFormatted\":\"02:00 pm\",\"airingType\":\"live\",\"contentRatings\":[],\"startTime\":1780074000,\"endTime\":1780077600,\"seriesId\":null,\"programId\":\"https://data.entertainment.tv.theplatform.com/entertainment/data/Program/guid/2710122407/EP031237411731\",\"title\":\"The Exchange\",\"episodeGuid\":\"EP031237411731\",\"description\":\"Anchor Kelly Evans reports on the important stories to markets and investors; reporters provide actionable information to viewers as they make daily investment decisions.\",\"credits\":null,\"displayGenre\":\"Bus./financial\",\"languages\":null,\"lastPubDate\":null,\"programType\":null,\"pubDate\":null,\"ratings\":null,\"runtime\":3600,\"secondaryTitle\":null,\"seriesEpisodeNumber\":1726,\"shortTitle\":\"The Exchange\",\"tvSeasonEpisodeNumber\":null,\"tvSeasonId\":null,\"tvSeasonNumber\":107,\"category\":null,\"showingType\":null,\"externalAdvertiserId\":\"cnbc_Live_EP031237411731\",\"fwReplaceSecondaryIds\":false,\"isTms\":false,\"__typename\":\"scheduleFields\"},{\"guid\":\"00003EP0